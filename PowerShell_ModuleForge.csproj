<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 파일명이 PowerShell_ModuleForge 여도 DLL 이름은 모듈 이름과 같게 -->
    <AssemblyName>PowerShell.ModuleForge</AssemblyName>
    <RootNamespace>PowerShell.ModuleForge</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.6.6"
                      ExcludeAssets="runtime;contentFiles" PrivateAssets="all" />
  </ItemGroup>
</Project>
